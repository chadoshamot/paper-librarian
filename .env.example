# ── 密钥文件模板 ─────────────────────────────────────────────
# 复制本文件为 .env 并填入你的值（.env 已被 .gitignore 排除，不会上传）。
# 更推荐直接运行 `python setup.py` 交互式生成 .env。

# ── LLM（DeepSeek，用于论文分类/摘要/每日裁判）──
# 获取：https://platform.deepseek.com → 创建 API Key
DEEPSEEK_API_KEY=

# ── ModelScope（云端同步 PDF / KB 用）──────────────────────
# 获取：https://modelscope.cn → 个人中心 → 访问令牌
# 说明：仅「自建库」模式需要；导入示例库（只读）可留空
MODELSCOPE_TOKEN=

# ── Kimi 联网对话（每日简报里嵌的聊天，可选）──────────────
# 获取：https://platform.moonshot.cn → API Key
# 可选：不填则「联网对话」功能不可用，其余照常
MOONSHOT_API_KEY=

# ── Zotero（链接文件模式，可选）────────────────────────────
# 获取：https://www.zotero.org/settings/keys → 新建 key（勾选读写）
# 可选：不填则仅本地检索/跳转，Zotero 联动不可用
ZOTERO_USER_ID=
ZOTERO_API_KEY=

# ── 邮箱推送（QQ 邮箱，可选）──────────────────────────────
# SMTP_PASS 是 QQ 邮箱「授权码」（QQ邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码），
# 不是登录密码。不填则「发送到邮箱」功能不可用。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_TO=
